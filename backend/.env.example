# Konfigurasi Runtime PATRIOT-AD Policy Gateway (Template)
# Salin file ini menjadi backend/.env lalu isi nilai rahasia sebelum menjalankan server lokal.
# File backend/.env diabaikan oleh Git (.gitignore) dan TIDAK boleh di-commit.

PATRIOT_MQTT_HOST=127.0.0.1
PATRIOT_MQTT_PORT=1883
PATRIOT_MQTT_USERNAME=patriot_gateway
PATRIOT_MQTT_PASSWORD=CHANGE_ME_GATEWAY_MQTT_PASSWORD

# Harus sama dengan COMMAND_HMAC_SECRET pada firmware/patriot_esp32_production/secrets.h
PATRIOT_COMMAND_HMAC_SECRET=CHANGE_ME_HMAC_SHA256_SHARED_SECRET

# Token autentikasi API & peran dashboard (header X-Patriot-Token)
PATRIOT_API_TOKEN=CHANGE_ME_ADMIN_API_TOKEN
PATRIOT_TOKEN_OPERATOR=CHANGE_ME_OPERATOR_TOKEN
PATRIOT_TOKEN_ADMIN=CHANGE_ME_ADMIN_TOKEN
PATRIOT_TOKEN_DASHBOARD=CHANGE_ME_DASHBOARD_TOKEN

# Daftar origin CORS frontend yang diizinkan (dipisah koma)
PATRIOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
