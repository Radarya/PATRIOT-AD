# ==============================================================================
# PATRIOT-AD Root .gitignore
# Melindungi kredensial, file internal non-repo, runtime DB, dan artefak build
# ==============================================================================

# 1. Secrets & Konfigurasi Lokal (JANGAN PERNAH PUSH KE GITHUB)
.env
.env.*
!.env.example
!.env.*.example
firmware/*/secrets.h
deploy/mosquitto/patriot_passwd

# 2. Dokumen Internal, Aset Media/Branding, CAD, & Skrip Generator Internal
docs/
assets/
hardware/
scripts/*
!scripts/mqtt_bridge.py
!scripts/serangan_penyusup.py
!scripts/stress_test.py

# 3. Runtime Forensic Database & Logs
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/checkpoints.jsonl
*.log

# 4. Python / Backend Environments & Cache
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 5. Node.js / Next.js Frontend
node_modules/
web/.next/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 6. Embedded / Arduino CLI Toolchain & Build Outputs
.tools/
firmware/**/build/
*.elf
*.bin
*.map
*.hex

# 7. Arsip Lokal, IDE Agent Config & File Sistem OS
web_archives/
.agents/
conversations.json
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
